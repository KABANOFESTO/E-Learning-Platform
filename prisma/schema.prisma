generator client {
  provider = "prisma-client-js"
}
datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
  admin
  instructor
  learner
}

model User {
  id             String      @id @default(uuid())
  name           String
  email          String      @unique
  password       String
  profilePicture String
  role           Role        @default(learner)
}